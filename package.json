{
  "name": "curling-band-inspector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "validate:synthetic": "node --experimental-strip-types scripts/validate-synthetic.ts",
    "smoke:browser": "node scripts/browser-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.18.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
